# Public URL used for metadata, the sitemap and Open Graph tags.
# Replace with the production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery — Resend (https://resend.com).
# Leave these unset and the form will return a clear "not configured" message
# instead of pretending the message was delivered.
RESEND_API_KEY=

# Must be a verified sender in Resend, e.g. "EmmyCodes <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Optional. Defaults to emmycodes1106@gmail.com.
CONTACT_TO_EMAIL=
